// Value scan controls and the result list.

import { Button, LineEdit, ComboBox, CheckBox, StandardTableView, ProgressIndicator, GroupBox, Palette } from "std-widgets.slint";
import { App, Choices, Tone } from "state.slint";
import { Heading, Muted } from "common.slint";

export component ScanPanel inherits GroupBox {
    title: @tr("Value scan");

    property <[string]> compares: App.has-scan ? Choices.next-compares : Choices.first-compares;
    property <string> compare: compares[compare-box.current-index];
    property <string> scan-type: Choices.scan-types[type-box.current-index];
    property <bool> needs-value: compare != "unknown" && compare != "changed" && compare != "unchanged" && compare != "increased" && compare != "decreased";
    property <bool> has-scan: App.has-scan;

    changed has-scan => {
        compare-box.current-index = 0;
    }

    function submit() {
        if (App.busy || !App.attached) {
            return;
        }
        if (App.has-scan) {
            App.next-scan(compare, value.text, value2.text);
        } else {
            App.first-scan(value.text, value2.text, scan-type, compare, writable.checked, aligned.checked);
        }
    }

    VerticalLayout {
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            value := LineEdit {
                enabled: root.needs-value;
                placeholder-text: !root.needs-value ? @tr("No value needed") : root.compare == "between" ? @tr("From") : root.scan-type == "bytes" ? @tr("Bytes, e.g. 48 8B ?? 05") : root.scan-type == "string" || root.scan-type == "string16" ? @tr("Text") : @tr("Value");
                accepted => {
                    root.submit();
                }
            }
            if root.compare == "between": Muted {
                text: "and";
            }
            value2 := LineEdit {
                visible: root.compare == "between";
                width: root.compare == "between" ? self.preferred-width : 0;
                placeholder-text: @tr("To");
                accepted => {
                    root.submit();
                }
            }
            type-box := ComboBox {
                model: Choices.scan-types;
                enabled: !App.has-scan;
                min-width: 110px;
            }
            compare-box := ComboBox {
                model: root.compares;
                min-width: 130px;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: App.has-scan ? @tr("New scan") : @tr("First scan");
                primary: !App.has-scan;
                enabled: App.attached && !App.busy;
                clicked => {
                    if (App.has-scan) {
                        App.reset-scan();
                        value.focus();
                    } else {
                        root.submit();
                    }
                }
            }
            Button {
                text: @tr("Next scan");
                primary: App.has-scan;
                enabled: App.has-scan && !App.busy;
                clicked => {
                    root.submit();
                }
            }
            Button {
                text: @tr("Undo");
                enabled: App.can-undo && !App.busy;
                clicked => {
                    App.undo-scan();
                }
            }
            Rectangle {
                width: 6px;
            }
            writable := CheckBox {
                horizontal-stretch: 0;
                text: @tr("Writable only");
                checked: true;
                enabled: !App.has-scan;
            }
            aligned := CheckBox {
                horizontal-stretch: 0;
                text: @tr("Aligned");
                checked: true;
                enabled: !App.has-scan;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }

        if App.busy: HorizontalLayout {
            spacing: 8px;
            Muted {
                text: App.busy-op == "pointer_scan" ? @tr("Pointer scan…") : App.busy-op == "watch" ? @tr("Watching…") : @tr("Scanning…");
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                ProgressIndicator {
                    progress: App.progress;
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    App.cancel();
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Heading {
                text: !App.has-scan ? @tr("No scan yet") : App.scan-total == 1 ? @tr("1 result") : @tr("{} results", App.scan-total);
            }
            if App.has-scan: Muted {
                text: @tr("step {}", App.scan-step);
            }
            Muted {
                text: App.scan-types-text;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if App.scan-type-filters.length > 2: ComboBox {
                model: App.scan-type-filters;
                current-index <=> App.scan-type-filter;
                selected => {
                    App.filter-results(self.current-index);
                }
            }
        }

        results := StandardTableView {
            vertical-stretch: 1;
            min-height: 90px;
            columns: [
                { title: @tr("Address"), min-width: 140px },
                { title: @tr("Type"), min-width: 70px },
                { title: @tr("Value"), horizontal-stretch: 1, min-width: 90px },
                { title: @tr("Previous"), horizontal-stretch: 1, min-width: 90px },
                { title: @tr("Where"), horizontal-stretch: 1, min-width: 140px },
            ];
            rows: App.results;
            row-pointer-event(row, event, pos) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    App.result-clicked(row);
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Muted {
                text: App.results-note;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Inspect");
                enabled: results.current-row >= 0 && results.current-row < App.results.length;
                clicked => {
                    App.inspect-address = App.results[results.current-row][0].text;
                    App.side-tab = 1;
                }
            }
            Button {
                text: @tr("Add to table");
                enabled: results.current-row >= 0 && results.current-row < App.results.length;
                clicked => {
                    App.add-result(results.current-row);
                }
            }
        }
    }
}
